opam-version: "2.0"
version: "0.9.3+9.0"
maintainer: "yannick.forster@inria.fr"
homepage: "https://github.com/MetaRocq/rocq-verified-extraction"
dev-repo: "git+https://github.com/MetaRocq/rocq-verified-extraction"
bug-reports: "https://github.com/MetaRocq/rocq-verified-extraction/issues"
synopsis: "Verified extraction from Rocq to OCaml"
authors: ["Yannick Forster"
          "Matthieu Sozeau"
          "Nicolas Tabareau"]
license: "MIT"
build: [
  [make]
]
install: [
  [make "-j%{jobs}%" "install"]
]
depends: [
  "rocq-core" { >= "9.1" }
  "rocq-stdlib" { >= "9.0" }
  "rocq-ceres-bytestring" { = "1.0.0" }
  "rocq-metarocq-erasure-plugin" { = "dev" }
  "malfunction" { >= "0.7.1" }
]
pin-depends: [
  ["rocq-metarocq-utils.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
  ["rocq-metarocq-common.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
  ["rocq-metarocq-template.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
  ["rocq-metarocq-pcuic.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
  ["rocq-metarocq-template-pcuic.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
  ["rocq-metarocq-safechecker.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
  ["rocq-metarocq-erasure.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
  ["rocq-metarocq-erasure-plugin.dev" "git+https://github.com/MetaRocq/metarocq.git#9.1"]
]
tags: [
  "keyword:extraction"
  "category:Miscellaneous/Rocq Extensions"
  "date:2025-04-23"
  "logpath:VerifiedExtraction"
]
